<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{subject}}</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background: linear-gradient(135deg, #0f0f1e 0%, #1a1a2e 50%, #16213e 100%);
      color: #e2e8f0;
      line-height: 1.6;
      min-height: 100vh;
    }
    
    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }
    
    .header {
      text-align: center;
      padding: 30px 20px;
      background: linear-gradient(135deg, rgba(34, 184, 235, 0.1) 0%, rgba(34, 184, 235, 0.05) 100%);
      border-radius: 12px 12px 0 0;
      border-bottom: 2px solid #22b8eb;
    }
    
    .logo {
      font-size: 28px;
      font-weight: 700;
      color: #22b8eb;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }
    
    .logo-icon {
      width: 40px;
      height: 40px;
    }
    
    .content {
      background: rgba(30, 41, 59, 0.6);
      backdrop-filter: blur(10px);
      padding: 30px;
      border-radius: 0 0 12px 12px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
    }
    
    h1, h2, h3 {
      color: #22b8eb;
      margin-bottom: 16px;
    }
    
    h1 { font-size: 24px; }
    h2 { font-size: 20px; }
    h3 { font-size: 18px; }
    
    p {
      margin-bottom: 16px;
      color: #cbd5e1;
    }
    
    a {
      color: #22b8eb;
      text-decoration: none;
    }
    
    a:hover {
      text-decoration: underline;
    }
    
    .button {
      display: inline-block;
      background: linear-gradient(135deg, #22b8eb 0%, #0ea5e9 100%);
      color: #0f172a !important;
      padding: 14px 28px;
      border-radius: 8px;
      font-weight: 600;
      text-decoration: none !important;
      margin: 20px 0;
      box-shadow: 0 4px 15px rgba(34, 184, 235, 0.3);
      transition: transform 0.2s;
    }
    
    .button:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(34, 184, 235, 0.4);
    }
    
    .divider {
      height: 1px;
      background: linear-gradient(90deg, transparent, #22b8eb, transparent);
      margin: 24px 0;
    }
    
    .info-box {
      background: rgba(34, 184, 235, 0.1);
      border-left: 4px solid #22b8eb;
      padding: 16px;
      margin: 20px 0;
      border-radius: 0 8px 8px 0;
    }
    
    .warning-box {
      background: rgba(245, 158, 11, 0.1);
      border-left: 4px solid #f59e0b;
      padding: 16px;
      margin: 20px 0;
      border-radius: 0 8px 8px 0;
    }
    
    .success-box {
      background: rgba(16, 185, 129, 0.1);
      border-left: 4px solid #10b981;
      padding: 16px;
      margin: 20px 0;
      border-radius: 0 8px 8px 0;
    }
    
    .footer {
      text-align: center;
      padding: 30px 20px;
      margin-top: 30px;
    }
    
    .social-links {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-bottom: 20px;
    }
    
    .social-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      background: rgba(34, 184, 235, 0.1);
      border-radius: 50%;
      transition: background 0.2s;
    }
    
    .social-link:hover {
      background: rgba(34, 184, 235, 0.2);
    }
    
    .donation-section {
      background: rgba(245, 158, 11, 0.1);
      border: 1px solid rgba(245, 158, 11, 0.3);
      padding: 20px;
      border-radius: 8px;
      margin: 20px 0;
    }
    
    .donation-button {
      display: inline-block;
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
      color: #0f172a !important;
      padding: 12px 24px;
      border-radius: 8px;
      font-weight: 600;
      text-decoration: none !important;
      margin-top: 10px;
    }
    
    .unsubscribe {
      font-size: 12px;
      color: #64748b;
      margin-top: 20px;
    }
    
    .list {
      list-style: none;
      padding: 0;
    }
    
    .list li {
      padding: 8px 0;
      padding-left: 24px;
      position: relative;
    }
    
    .list li:before {
      content: "✈";
      position: absolute;
      left: 0;
      color: #22b8eb;
    }
    
    .highlight {
      color: #22b8eb;
      font-weight: 600;
    }
    
    .text-danger {
      color: #ef4444;
    }
    
    @media (max-width: 600px) {
      .container {
        padding: 10px;
      }
      
      .content {
        padding: 20px;
      }
      
      .logo {
        font-size: 24px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <a href="https://flightjobs.bsite.net" class="logo">
        <svg class="logo-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
