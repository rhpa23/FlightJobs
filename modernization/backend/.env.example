# Environment Variables
NODE_ENV=development
PORT=3001

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=flightjobs

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Map Configuration
MAPBOX_ACCESS_TOKEN=your-mapbox-token
OPENWEATHER_API_KEY=your-openweather-api-key

# Email Configuration (mesmos dados do Web.config legado)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=flightjobs.net.no.reply@gmail.com
MAIL_PASS=your-gmail-app-password
MAIL_FROM=flightjobs.net.no.reply@gmail.com
MAIL_FROM_NAME=FlightJobs
MAIL_SECURE=false

# Email Security Settings
MAIL_SEND_ENABLED=true
MAIL_RATE_LIMIT_PER_HOUR=100
MAIL_MAX_RECIPIENTS_PER_BATCH=50
MAIL_TEST_MODE=true
MAIL_TEST_WHITELIST=admin@flightjobs.net,rhpa23@yahoo.com.br
MAIL_THROTTLE_MS=5000
MAIL_USE_QUEUE=false

# Redis Configuration (para fila de emails)
REDIS_HOST=localhost
REDIS_PORT=6379
